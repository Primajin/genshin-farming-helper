{
  "name": "genshin-farming-helper",
  "version": "1.0.0",
  "private": true,
  "description": "Proof of concept of a helper for keeping track while farming in Genshin Impact",
  "homepage": "https://helper.farm/",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "coverage": "vitest run --coverage",
    "deploy": "gh-pages -d build",
    "generate": "node src/scripts/generate-data.js",
    "lint": "xo --config xo.config.js",
    "lint:fix": "npm run lint -- --fix",
    "lint:watch": "npx nodemon -x npm run lint:fix --ext js,jsx,json",
    "prebuild": "npm run generate",
    "precoverage": "npm run generate",
    "predeploy": "npm run build",
    "prestart": "npm run generate",
    "pretest": "npm run generate",
    "publish": "npm run deploy",
    "serve": "vite preview",
    "start": "vite",
    "test": "vitest"
  },
  "keywords": [
    "genshin impact",
    "genshin",
    "impact",
    "farming"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/material-symbols-outlined": "^5.3.6",
    "genshin-db": "^5.2.13",
    "gh-pages": "^6.3.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-config-xo-react": "^0.32.0",
    "jsdom": "^30.0.1",
    "vite": "^8.3.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^5.0.1",
    "xo": "^5.0.1"
  },
  "overrides": {
    "@codecov/vite-plugin": {
      "vite": "$vite"
    }
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
